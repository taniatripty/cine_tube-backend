model Wishlist {
  userId  String
  mediaId String

  createdAt DateTime @default(now())

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
 
  @@id([userId, mediaId])
  @@index([mediaId])
    @@map("wishlist")
}