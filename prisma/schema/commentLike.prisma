model CommentLike {
  userId    String
  commentId String

  createdAt DateTime @default(now())
 
 user User @relation(fields: [userId] ,references: [id] , onDelete: Cascade)
 comment Comment @relation(fields: [commentId] , references: [id] , onDelete: Cascade)
  @@id([userId, commentId])
  @@index([commentId])
  @@map("commentLike")
}