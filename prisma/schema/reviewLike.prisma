model ReviewLike {
  userId   String
  reviewId String
  type     ContentReactionType

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId, type])
  @@map("reviewLike")
}
